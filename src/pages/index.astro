---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import ProductCards from '../components/ProductCards.astro';
const industries=[['Maloprodaja','Ponude koje prate ritam vaše prodavnice.','maloprodaja'],['Banke','Jasne informacije, od ulaza do šaltera.','banke'],['Restorani','Današnja ponuda bez novog štampanja.','restorani'],['Hoteli','Dobrodošlica, događaji i informacije za goste.','hoteli'],['Apoteke','Uredna komunikacija na mestu odluke.','apoteke']];
---
<Base title="Elektronski papir za poslovne prostore | epaper.rs" description="Samsung Color E-Paper 13 i 32 inča za cenovnike, menije i digitalne postere. Net Planet DOO: prezentacija i B2B ponuda za Srbiju i region." path="/" image="/images/samsung-e-paper-knjizara-13-incha.webp">
<section class="hero"><div class="container">
<div class="hero-grid"><div class="hero-copy"><span class="eyebrow">Samsung Color E-Paper · B2B rešenja</span><h1>Izgleda kao papir.<br/>Radi <span class="serif">za vaše poslovanje.</span></h1><p class="hero-intro">Promenite ponudu, ne poster. Elektronski papir u boji donosi digitalnu fleksibilnost cenovnicima, menijima i porukama u vašem prostoru.</p><div class="hero-actions"><a class="button" href="/kontakt/">Zatražite prezentaciju <span aria-hidden="true">↗</span></a><a class="text-link" href="/proizvodi/">Istražite uređaje <span aria-hidden="true">→</span></a></div><div class="hero-meta"><span class="mini-icon" aria-hidden="true">✓</span><span>Net Planet DOO, Beograd<br/>Za pravna lica u Srbiji i regionu</span></div></div>
<div class="hero-visual"><img src="/images/samsung-e-paper-knjizara-13-incha.webp" width="2048" height="1149" fetchpriority="high" alt="Samsung Color E-Paper na prodajnom stolu u knjižari, ilustracija primene"/><a href="/proizvodi/samsung-color-e-paper/13-incha/" class="visual-label"><div><strong>Velika promena. Mali format.</strong><small>Upoznajte Samsung Color E-Paper 13″</small></div><span class="round-arrow" aria-hidden="true">↗</span></a></div></div>
<div class="feature-strip"><div><strong>Prikaz nalik papiru</strong><small>Statična slika u boji</small></div><div><strong>13″ i 32″</strong><small>Dva formata, mnogo primena</small></div><div><strong>Sadržaj pod kontrolom</strong><small>Lokalno ili centralno upravljanje</small></div><div><strong>Bez stalnog napajanja</strong><small>Uz bateriju i povremeno punjenje</small></div></div>
</div></section>
<section class="section paper-white"><div class="container"><div class="section-head"><div><span class="eyebrow">Izaberite svoj format</span><h2>Prava poruka.<br/><span class="serif">Na pravom mestu.</span></h2></div><p>Od informacije na pultu do promotivnog postera. Dva Samsung uređaja, odabrana prema prostoru, sadržaju i udaljenosti čitanja.</p></div><ProductCards/><div class="comparison-note"><span>Tehničke dijagonale: 13,3″ i 31,5″. Uređaji su namenjeni unutrašnjim prostorima.</span><a class="text-link" href="/proizvodi/samsung-color-e-paper/">Uporedite modele <span aria-hidden="true">→</span></a></div></div></section>
<section class="section dark-section"><div class="container split"><div class="split-image"><img src="/images/samsung-e-paper-kafe-digitalni-meni.webp" width="1101" height="619" loading="lazy" alt="Samsung e-paper sa digitalnim menijem na pultu ugostiteljskog prostora"/></div><div><span class="eyebrow">Papirni izgled. Digitalna sloboda.</span><h2>Poruka ostaje.<br/><span class="serif">Vi menjate sadržaj.</span></h2><p>Elektronski papir zadržava statičnu sliku bez stalnog napajanja za sam prikaz. Energija je potrebna za promenu sadržaja, komunikaciju i druge funkcije uređaja.</p><ul class="number-list"><li><span>01</span><strong>Manje ponovljenog štampanja pri promeni ponude.</strong></li><li><span>02</span><strong>Mirna, čitljiva komunikacija bez video-animacija.</strong></li><li><span>03</span><strong>Fleksibilnije pozicioniranje uz baterijsko napajanje.</strong></li></ul><a class="button button-light" href="/tehnologija/elektronski-papir/">Kako radi elektronski papir <span aria-hidden="true">↗</span></a></div></div></section>
<section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Rešenja koja imaju svrhu</span><h2>Šta danas želite<br/><span class="serif">da kažete kupcima?</span></h2></div><a class="text-link" href="/resenja/">Sva rešenja <span aria-hidden="true">→</span></a></div><div class="cards-three">
<a class="solution-card" href="/resenja/digitalni-cenovnici/"><img src="/images/samsung-e-paper-digitalni-cenovnici.webp" width="667" height="497" loading="lazy" alt="Elektronski cenovnik uz sveže proizvode u prodavnici, Samsung ilustracija"/><div class="solution-card-content"><h3>Cene koje prate<br/>vašu ponudu.</h3><p>Istaknite izabrane proizvode, usluge i akcije bez ponovnog štampanja celog cenovnika.</p><span class="text-link">Digitalni cenovnici <span aria-hidden="true">→</span></span></div></a>
<a class="solution-card" href="/resenja/digitalni-meniji/"><img src="/images/samsung-e-paper-restoran-digitalni-posteri.webp" width="1249" height="850" loading="lazy" alt="Samsung e-paper posteri sa ponudom restorana u enterijeru"/><div class="solution-card-content"><h3>Današnji meni.<br/>Uvek aktuelan.</h3><p>Predstavite dnevna jela, sezonske novitete i posebnu ponudu u mirnom, papirnom formatu.</p><span class="text-link">Digitalni meniji <span aria-hidden="true">→</span></span></div></a>
<a class="solution-card" href="/resenja/digitalni-posteri-za-izlog/"><img src="/images/samsung-e-paper-prodajni-prostor.webp" width="1104" height="778" loading="lazy" alt="Samsung Color E-Paper promotivni poster u prodavnici odeće"/><div class="solution-card-content"><h3>Izlog sa novom<br/>pričom.</h3><p>Menjajte kampanje i ključne poruke na posteru postavljenom sa unutrašnje strane izloga.</p><span class="text-link">Digitalni posteri <span aria-hidden="true">→</span></span></div></a>
</div></div></section>
<section class="section paper-white"><div class="container split"><div><span class="eyebrow">Upravljanje sadržajem</span><h2>Jedan uređaj ili mreža lokacija.<br/><span class="serif">Vi birate pristup.</span></h2><p class="muted">Za lokalne promene tu je Samsung E-Paper aplikacija. Kada vam treba upravljanje većim brojem uređaja i planiranje sadržaja, razmotrite Samsung VXT kao posebno licencirano rešenje.</p><p class="muted">Pre ponude proveravamo obim sistema, mrežne uslove i način rada vašeg tima.</p><a class="text-link" href="/softver/">Pronađite način upravljanja <span aria-hidden="true">→</span></a></div><div class="software-screen"><img src="/images/samsung-vxt-upravljanje-sadrzajem.webp" width="673" height="394" loading="lazy" alt="Samsung VXT interfejs za pripremu i upravljanje sadržajem elektronskih postera"/></div></div></section>
<section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Prostor određuje rešenje</span><h2>Za mesta gde je<br/><span class="serif">važna prava informacija.</span></h2></div><p>Ne počinjemo od ekrana, već od onoga što vaši kupci, klijenti i gosti treba da vide.</p></div><div class="industry-list">{industries.map(([name,description,slug],i)=><a class="industry-row" href={'/industrije/'+slug+'/'}><span class="index">0{i+1}</span><h3>{name}</h3><p>{description}</p><span aria-hidden="true">↗</span></a>)}</div></div></section>
<section class="section paper-white"><div class="container"><div class="section-head"><div><span class="eyebrow">Jasan put do nabavke</span><h2>Najpre dobar plan.<br/><span class="serif">Zatim prava oprema.</span></h2></div><p>Nabavka po porudžbini, sa uslovima definisanim u B2B ponudi. Bez nepotrebnog nagađanja.</p></div><div class="process"><div><span>01 / RAZGOVOR</span><h3>Vaša primena</h3><p>Dogovaramo sadržaj, lokacije, količinu uređaja i očekivani način ažuriranja.</p></div><div><span>02 / PREPORUKA</span><h3>Prezentacija i ponuda</h3><p>Dobijate preporuku formata, načina upravljanja i potrebne prateće opreme.</p></div><div><span>03 / REALIZACIJA</span><h3>Nabavka po meri</h3><p>Rok do 60 dana i uslove isporuke potvrđujemo u ponudi. Garancija je 2 godine, uz mogućnost produženja do 5 prema ugovorenim uslovima.</p></div></div><p class="fineprint">Fotografije prikazuju Samsung ilustracije primene proizvoda, a ne reference izvedenih projekata Net Planet DOO.</p></div></section>
<CTA/>
</Base>
