<section id="analytics-consent" class="analytics-consent" data-analytics-consent role="region" aria-labelledby="analytics-consent-title" hidden>
  <div class="analytics-consent-copy">
    <h2 id="analytics-consent-title" tabindex="-1">Analitika sajta</h2>
    <p>Uz vaš pristanak koristimo Google Analytics da razumemo posećenost sajta. Analitika se ne uključuje dok ne prihvatite. Izbor možete promeniti u podnožju.</p>
    <a href="/politika-privatnosti/#google-analytics">Više o analitici i podacima</a>
  </div>
  <div class="analytics-consent-actions">
    <button type="button" data-analytics-choice="denied">Odbijam analitiku</button>
    <button type="button" data-analytics-choice="granted">Prihvatam analitiku</button>
    <button class="analytics-consent-close" type="button" data-analytics-close hidden>Zatvori bez izmene</button>
  </div>
</section>
<script src="../scripts/analytics.js"></script>
<style is:global>
  .analytics-consent[hidden], .analytics-consent button[hidden], .analytics-settings[hidden] { display: none !important; }
  .analytics-consent { position: fixed; z-index: 60; inset: auto 20px 20px; max-width: 1020px; margin-inline: auto; padding: 24px; border: 1px solid #a5b69c; border-radius: 6px; background: #fff; box-shadow: 0 8px 40px #102b2433; display: flex; align-items: center; gap: 24px; max-height: calc(100dvh - 40px); overflow-y: auto; }
  .analytics-consent h2 { font-size: 24px; margin-bottom: 10px; }
  .analytics-consent p { font-size: 13px; line-height: 1.65; margin-bottom: 8px; }
  .analytics-consent-copy { flex: 1; }
  .analytics-consent a { font-size: 12px; text-decoration: underline; text-underline-offset: 3px; }
  .analytics-consent-actions { display: grid; grid-template-columns: 1fr; gap: 10px; flex: 0 0 190px; }
  .analytics-consent-actions button { color: var(--green); border: 1px solid var(--green); background: #fff; border-radius: 4px; padding: 12px 15px; font-size: 12px; font-weight: 650; cursor: pointer; min-height: 44px; }
  .analytics-consent-actions button:hover { background: #eef3e7; }
  .analytics-consent-actions .analytics-consent-close { border: 0; text-decoration: underline; }
  .analytics-settings { color: inherit; background: none; border: 0; border-radius: 0; font: inherit; text-decoration: underline; padding: 0; cursor: pointer; }
  .footer-bottom { flex-wrap: wrap; align-items: center; }
  @media (max-width: 620px) {
    .analytics-consent { inset: auto 10px 10px; padding: 18px; gap: 16px; flex-direction: column; align-items: stretch; max-height: calc(100dvh - 20px); }
    .analytics-consent-actions { grid-template-columns: 1fr 1fr; flex: auto; }
    .analytics-consent-actions .analytics-consent-close { grid-column: 1 / -1; }
  }
</style>
